# LegacyLens: copy to .env and fill in your keys

# Required: Google Gemini API
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional: private GitHub repos
GITHUB_TOKEN=your_github_token_here

# Optional: OpenRouter (for VB6 node alternative LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: LangSmith monitoring
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=legacylens

# LLM behaviour (all optional)
GEMINI_MODEL=gemini-3.5-flash   # change here when Google retires a model
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite  # used when a model hits its daily quota
LLM_TIMEOUT=120                 # seconds per request
LLM_MAX_ATTEMPTS=4              # tries per request on 429 / 5xx / timeout
LLM_RETRY_DELAY=4               # first backoff in seconds (then 8, 16...)
LLM_RPM=8                       # requests per minute across all nodes (free tier ~10)
